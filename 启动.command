#!/bin/bash
# 诗境 · 山河 —— 启动后端服务（双击本文件即可）
#
# 这是中文名入口，逻辑全部在 start.command 里（两级 fork 脱离终端 + pid 文件 +
# 端口就绪等待 + 自动开浏览器）。这里只做转调，不复制一份逻辑 ——
# 两份逻辑迟早会改歪，而「双击哪个图标」不该决定行为。
#
# 命令行用法：
#   ./启动.command          默认 8777 端口
#   ./启动.command 8080     换端口

DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$DIR/start.command" "$@"
